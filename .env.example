# VayuPress environment — copy to .env and edit. NEVER commit your real .env.
# Used by docker-compose.yml. See docs/INSTALLATION.md for the full variable list.

# REQUIRED — a strong, random admin API key (e.g. `openssl rand -hex 32`).
API_KEY=change-me-to-a-long-random-secret

# Your public domain (used for canonical URLs, sitemap, feed, CORS).
DOMAIN=localhost

# Build version stamp shown in the admin panel and /health.
VAYU_VERSION=docker

# --- Optional: Meilisearch (uncomment the service in docker-compose.yml) ------
# MEILI_MASTER_KEY=change-me-to-another-long-random-secret

# --- Optional: signed self-update (see docs/UPGRADING.md) ---------------------
# VAYU_SELFUPDATE_ENABLED=false
# VAYU_RELEASE_PUBKEY=


# --- VayuOS Phase 2: Mail (VayuMail) + PGP (VayuPGP) ---------------------------
# VayuMail activates automatically when DOMAIN is a real domain (not localhost).
# Outbound DKIM keys, the PGP keystore, and Maildir live under <dir(DB_PATH)>/vayudata/.
# The PGP at-rest encryption key is derived from API_KEY — keep API_KEY stable.
#
# Opt-in security-update watcher (privacy default = off). When "on" it fetches
# only public GitHub release metadata for the crypto dependencies powering
# VayuPGP/VayuMail and surfaces available patches in /os/vayuos/security.
# VAYUOS_SECURITY_UPDATES=off

# VayuTor — publish every hosted domain as a Tor v3 onion service alongside its
# clearnet URL, driven over a local tor daemon's cookie-authenticated control
# port. VAYUOS_TOR is the master switch (default on/available; set off to
# hard-disable); the actual on/off is the one-click toggle on the VayuTor page
# (default off). VayuTor opens no inbound ports and records nothing about a
# visitor beyond an aggregate count.
#
# Managed mode (default on): when no external control port is reachable,
# VayuPress runs its OWN tor daemon as the unprivileged service user, so VayuTor
# works with only the `tor` binary installed — no root, no systemd, no
# control-port setup. It prefers an external VAYUOS_TOR_CONTROL_ADDR when one is
# reachable, and falls back to the managed instance otherwise. Set
# VAYUOS_TOR_MANAGED=off to require an external tor only.
# VAYUOS_TOR=on
# VAYUOS_TOR_CONTROL_ADDR=127.0.0.1:9051
# VAYUOS_TOR_COOKIE=/run/tor/control.authcookie
# VAYUOS_TOR_MANAGED=on                 # self-managed tor fallback (off = external only)
# VAYUOS_TOR_BINARY=                    # explicit tor path (default: found on PATH)
# VAYUOS_TOR_DIR=                       # managed tor state dir (default: <state>/tor)
#
# Bridges: if your network/VPS blocks Tor at the IP level (bootstrap fails with
# "No route to host"), VayuTor auto-escalates direct → 80/443-only → bridges.
# Supply obfs4 bridges from https://bridges.torproject.org (or email
# bridges@torproject.org) as newline/";"-separated torrc Bridge lines. Needs the
# obfs4proxy package (the deploy/update script installs it).
# VAYUOS_TOR_BRIDGES="obfs4 A.B.C.D:443 <FINGERPRINT> cert=<...> iat-mode=0; obfs4 E.F.G.H:443 <FINGERPRINT> cert=<...> iat-mode=0"


# --- VayuOS Phase 2 (cont.): inbound mail ------------------------------------
# The SMTP/IMAP receive listeners start automatically once DOMAIN is set, so the
# instance can receive external mail. Set VAYUOS_MAIL_INBOUND=off to run
# outbound-only. Binding the ports is best-effort: a failed bind (e.g. :25
# without privileges) is surfaced in /os/vayuos but never blocks outbound/local
# delivery. Receiving external mail also needs port 25 reachable + MX/A records.
# VAYUOS_MAIL_INBOUND=on
# VAYUOS_MAIL_SMTP_LISTEN=:25
# VAYUOS_MAIL_IMAP_LISTEN=:143
# VAYUOS_MAIL_SUBMISSION_LISTEN=:587
# VAYUOS_MAIL_IMAPS_LISTEN=:993
# VAYUOS_MAIL_POP3_LISTEN=:110            # POP3 (STLS); INBOX only — IMAP is the richer multi-folder protocol
# VAYUOS_MAIL_POP3S_LISTEN=:995           # implicit-TLS POP3S
# TLS for the mail listeners (STARTTLS on 25/587/143, implicit TLS on 993).
# Drop in a CA-signed cert (e.g. Let's Encrypt) for verified client use;
# when unset, VayuMail generates an in-memory self-signed cert so opportunistic
# STARTTLS still works out of the box.
# VAYUOS_MAIL_TLS_CERT=/etc/letsencrypt/live/mail.example.com/fullchain.pem
# VAYUOS_MAIL_TLS_KEY=/etc/letsencrypt/live/mail.example.com/privkey.pem
#
# Native ACME (Let's Encrypt) auto-provisioning — the foolproof option for real
# mail apps. With no static cert set, turn this on and VayuMail obtains and
# auto-renews a trusted certificate for mail.<domain> itself (no certbot). The
# HTTP-01 challenge is answered on VAYUOS_MAIL_ACME_HTTP_ADDR (default :80), so
# that port must be reachable for the mail hostname; on a bare VPS this just
# works. Mobile/desktop clients reject the self-signed fallback but accept this.
# VAYUOS_MAIL_TLS_ACME=on
# VAYUOS_MAIL_ACME_EMAIL=admin@example.com
# VAYUOS_MAIL_ACME_HTTP_ADDR=:80          # move to a free port + reverse-proxy /.well-known/acme-challenge/ if :80 is taken
# VAYUOS_MAIL_ACME_CACHE=                 # cert cache dir (default <storage>/mail/acme)
# VAYUOS_MAIL_ACME_HOSTS=                 # extra hostnames to include, comma-separated
# VAYUOS_MAIL_ACME_DIRECTORY=             # override ACME directory (e.g. LE staging) for testing
#
# Optional outbound smarthost relay. By default VayuMail delivers outbound mail
# sovereignly, direct-to-MX. A brand-new self-hosted IP has no sending
# reputation, so mail can still be spam-filed by Gmail/Outlook until it warms
# up. Setting VAYUOS_MAIL_RELAY_HOST routes outbound through an authenticated
# relay whose established IP reputation carries deliverability — while inbound
# receive, IMAP, local delivery and DKIM signing all stay self-hosted. VayuMail
# still DKIM-signs with your domain key, so DMARC stays aligned. Credentials are
# read from the environment only and never persisted.
# VAYUOS_MAIL_RELAY_HOST=smtp.provider.com
# VAYUOS_MAIL_RELAY_PORT=587            # 587 STARTTLS submission / 465 implicit TLS / 25
# VAYUOS_MAIL_RELAY_USERNAME=apikey
# VAYUOS_MAIL_RELAY_PASSWORD=your-relay-password
# VAYUOS_MAIL_RELAY_TLS=on              # require encryption before AUTH (default on; set off only for a trusted private-network relay)

# ── Public discovery rate limit ──────────────────────────────────────────────
# The unauthenticated .well-known discovery endpoints (WKD key lookup, mail
# autoconfig) are throttled per client IP to cap abusive enumeration / DoS of the
# per-request keystore scan. The default is deliberately generous so ordinary
# mail-client key discovery is never affected; raise it for a busy shared-NAT
# deployment, or lower it to tighten. Trusted IPs (TRUSTED_IPS) bypass entirely.
# DISCOVERY_RATE_LIMIT=240              # requests per 10-minute window per IP (default 240)
