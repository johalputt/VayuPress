# Compiled binaries (anchored to repo root so cmd/vayupress/ source is NOT ignored)
/vayupress
vayupress.exe
*.exe
*.dll
*.so
*.dylib

# Go build artifacts
*.test
*.out
/vendor/

# IDE & editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# OS
Thumbs.db
Desktop.ini

# Logs (local only — production logs go to /var/log/vayupress/)
*.log

# Secrets (never commit these)
.env
.env.*
!.env.example
!.env.production.example
*.secrets
/root/.vayupress-secrets
/root/.vayupress-admin

# Local test databases
*.db
*.db-wal
*.db-shm

# Temp & build dirs
/tmp/
dist/
build/

# Test coverage
coverage.out
coverage.html
*.coverprofile

# Build output
bin/
tools/vayu-compat/vayu-compat

# Benchmarks & profiling output
*.pprof
cpu.prof
mem.prof

# Note: go.mod and go.sum are intentionally NOT ignored.
# They must be committed when Go source is present in this repo.
.claude/
# CLAUDE.md is intentionally tracked — it holds standing agent instructions
# that every session (including fresh clones) must auto-follow.
