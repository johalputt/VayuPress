# Production-only administration boundary. ADMIN_ALLOWED_IPS is required by
# docker-compose.production.yml and accepts space-separated IP addresses/CIDRs.
{
	servers {
		# Bound slow clients and oversized request headers at the public edge.
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
		max_header_size 32KB

		# Avoid replaying state-changing requests as HTTP/3 early data.
		0rtt off
	}
}

(vayupress_proxy) {
	reverse_proxy vayupress:8080 {
		# Preserve long-lived WebSocket/SSE sessions across ordinary reloads,
		# but eventually recycle abandoned streams.
		stream_close_delay 5m
		stream_timeout 24h

		transport http {
			dial_timeout 10s
			response_header_timeout 60s
			write_timeout 30s
			max_response_header 32KB
		}
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# JSON access logs go to stdout for `docker compose logs caddy`. Caddy
	# redacts Cookie and Authorization values by default.
	log {
		output stdout
		format json
	}

	# Match the VPS edge cap. Endpoint-specific, smaller application limits
	# remain authoritative after the request reaches VayuPress.
	request_body {
		max_size 50MiB
	}

	# Set defense-in-depth defaults only when VayuPress did not set the header.
	# In particular, never replace its per-request nonce-based CSP.
	header {
		# No "preload": that token is a request to be added to the browsers' built-in
		# preload list, which is a one-way commitment for the apex AND every
		# subdomain, and it is dishonest to advertise without submitting. Add it
		# deliberately once you have.
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?X-XSS-Protection "1; mode=block"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	route {
		@allowed_admin {
			path /os /os/* /admin /admin/*
			remote_ip {$ADMIN_ALLOWED_IPS}
		}
		handle @allowed_admin {
			import vayupress_proxy
		}

		@admin path /os /os/* /admin /admin/*
		handle @admin {
			respond "Not Found" 404
		}

		handle {
			import vayupress_proxy
		}
	}
}
