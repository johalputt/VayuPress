# Production-only administration boundary. ADMIN_ALLOWED_IPS is required by
# docker-compose.production.yml and accepts space-separated IP addresses/CIDRs.
{$DOMAIN:localhost} {
	encode zstd gzip

	route {
		@allowed_admin {
			path /os /os/* /admin /admin/*
			remote_ip {$ADMIN_ALLOWED_IPS}
		}
		handle @allowed_admin {
			reverse_proxy vayupress:8080
		}

		@admin path /os /os/* /admin /admin/*
		handle @admin {
			respond "Not Found" 404
		}

		handle {
			reverse_proxy vayupress:8080
		}
	}
}
